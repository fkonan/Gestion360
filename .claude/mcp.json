{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/mcp.json",
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": ["artisan", "boost:serve"],
      "cwd": "${workspaceFolder}",
      "env": {
        "APP_ENV": "local"
      },
      "description": "Laravel Boost MCP - Official Laravel AI tooling with database schema, routes, docs, tinker, and logs access",
      "autoStart": true,
      "requirements": {
        "packageJson": false,
        "composerJson": {
          "require-dev": {
            "laravel/boost": "*"
          }
        }
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/mcp-server-filesystem",
        "${workspaceFolder}/app",
        "${workspaceFolder}/config",
        "${workspaceFolder}/database",
        "${workspaceFolder}/routes",
        "${workspaceFolder}/tests",
        "${workspaceFolder}/resources"
      ],
      "description": "Read-only filesystem access for Laravel project directories",
      "autoStart": false
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/mcp-server-sqlite",
        "--db-path",
        "${workspaceFolder}/database/database.sqlite"
      ],
      "description": "SQLite database access for Laravel projects using SQLite",
      "autoStart": false,
      "requirements": {
        "files": ["database/database.sqlite"]
      }
    }
  },
  "defaults": {
    "laravel": {
      "servers": ["laravel-boost"],
      "detection": {
        "files": ["artisan", "composer.json"],
        "composerRequire": ["laravel/framework"]
      }
    }
  }
}
